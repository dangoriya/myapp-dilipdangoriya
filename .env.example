# MyApp Environment Configuration
# 
# COPY THIS FILE TO .env AND EDIT VALUES FOR YOUR ENVIRONMENT
# cp .env.example .env

# =============================================================================
# Authentication Flow Configuration
# =============================================================================
# Set to "local" for username/password authentication, or "oidc" for SSO/OIDC
# Valid values: "local" | "oidc"
AUTH_FLOW=local

# Application Public URL
# This is the external URL users access the application at
# Used for redirects (logout, callbacks) when proxy headers are not available
# Examples: http://localhost:8080 | https://myapp.example.com
APPLICATION_URL=http://localhost:8080


# =============================================================================
# Auth Server (OIDC Provider) Configuration
# Required when AUTH_FLOW=oidc
# Replace these values with your auth-server details
# For Google or other popular SSO/IAM servers, update accordingly
# =============================================================================

# Public URL of the auth server (used for browser redirects - authorize, logout)
AUTH_SERVER_URL=http://localhost:8005

# Internal URL for server-to-server calls (token exchange, JWKS, userinfo)
# Only needed if different from AUTH_SERVER_URL (e.g., Docker: http://auth_server:8000)
# If not set, falls back to AUTH_SERVER_URL
# Use host.docker.internal when auth-server runs on host machine (not in Docker)
AUTH_SERVER_INTERNAL_URL=http://host.docker.internal:8005

# Client credentials (register your app at auth_server_management or via API)
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret

# Redirect URI for OIDC authorization code flow (must match registered URI)
REDIRECT_URI=http://localhost:8080/api/auth/callback

# Post-logout redirect URI (must match registered URI)
# This IS passed to the auth server's /logout endpoint as post_logout_redirect_uri parameter
POST_LOGOUT_REDIRECT_URI=http://localhost:8080

# OIDC Scopes to request
OIDC_SCOPES=openid profile email


# =============================================================================
# Session Configuration
# =============================================================================
SESSION_TTL_HOURS=3
SESSION_SECRET=your_session_secret_min_32_chars

# Cookie Security (set to true in production with HTTPS)
SECURE_COOKIE=false


# =============================================================================
# Role Mapping Configuration (JSON)
# Maps auth-server roles to local application roles
# If auth-server returns roles not in this map, user gets DEFAULT_ROLE
# =============================================================================
ROLE_MAPPING='{"admin": "admin-only", "administrator": "admin-only", "superadmin": "admin-only", "user": "normal-user", "member": "normal-user", "normal-user": "normal-user"}'

# Default role when auth-server returns no roles or unmapped roles
DEFAULT_ROLE=normal-user

# Enable PKCE for authorization code flow (recommended for public clients)
USE_PKCE=true


# =============================================================================
# Database Configuration
# =============================================================================
# Set to "true" to run migrations on container start (resets DB schema)
# Set to "false" to skip migrations (preserve existing data)
RESET_DB=false

# Host path for SQLite database volume (used by docker-compose)
# Example: /home/user/docker-volumes/myapp
DB_VOLUME_PATH=/home/dilip-dangoriya/docker-volumes/myapp-dilipdangoriya